---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroPhotoCarousel from '../../components/Company/HeroPhotoCarousel.astro';
import AboutSection from '../../components/Company/AboutSection.astro';
import HistorySection from '../../components/Company/HistorySection.astro';
import TimelineSection from '../../components/Company/TimelineSection.astro';
import ValuesSection from '../../components/Company/ValuesSection.astro';
import TeamSection from '../../components/Company/TeamSection.astro';
import ContactsSection from '../../components/Company/ContactsSection.astro';
---

<BaseLayout
	headerVariant="solid-shadow"
	forceLightTheme
	title="Our Company | ThingsBoard"
	description="Learn about ThingsBoard — our story, mission, team, and values behind the world's best IoT platform."
>
	<HeroPhotoCarousel />
	<AboutSection />
	<HistorySection />
	<TimelineSection />
	<ValuesSection />
	<TeamSection />
	<ContactsSection />
</BaseLayout>

<style is:global>
	/* The page's one entrance: a block marked `data-reveal` rises 16px and fades in, once, as it scrolls
	   into view, on the homepage hero's easing. Without scripts, or under reduced motion, it is simply
	   there. */
	@media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
		[data-reveal] {
			transition:
				opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
				transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		}

		[data-reveal]:not([data-revealed]) {
			opacity: 0;
			transform: translate3d(0, 16px, 0);
		}
	}

	@media print {
		[data-reveal] {
			opacity: 1 !important;
			transform: none !important;
		}
	}
</style>

<script>
	const blocks = document.querySelectorAll<HTMLElement>('[data-reveal]');
	const observer = new IntersectionObserver(
		(entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting) continue;
				entry.target.setAttribute('data-revealed', '');
				observer.unobserve(entry.target);
			}
		},
		{ rootMargin: '0px 0px -10% 0px' },
	);
	blocks.forEach((block) => observer.observe(block));
</script>
