---
/**
 * "Our values": the section's title, then a black card on the page measure — the value's words in a
 * third (its mark, title and sentence, the dots underneath) and its photo in the other two, faded in
 * from the black as the homepage hero's footage is. Contained because the photos are not sharp enough
 * to run full width. Slides cross-fade; no scrim, blur or pattern. The earlier full-bleed version is
 * `ValuesSectionOverlay`.
 */
import { Image } from 'astro:assets';
import Mark from '../ui/Mark.astro';
import { companyValues } from '~/data/company/values';
import '@styles/ui-kit.scss';
---

<section class="values" data-values-split aria-roledescription="carousel" aria-labelledby="values-title">
	<h2 class="values__heading" id="values-title">Our values</h2>
	<div class="values__card" data-reveal>
		<div class="values__copy">
			<div class="values__texts">
				{companyValues.map((value, i) => (
					<div class:list={['values__text', i === 0 && 'is-active']} aria-hidden={i === 0 ? undefined : 'true'}>
						<Mark size={48} icon={value.mark.icon} accent={value.mark.accent} class="values__mark" />
						<h3 class="values__title">{value.title}</h3>
						<p class="values__lede">{value.description}</p>
					</div>
				))}
			</div>
			<div class="values__dots print:hidden">
				{companyValues.map((value, i) => (
					<button
						type="button"
						class:list={['values__dot', i === 0 && 'is-active']}
						aria-label={value.title}
						aria-current={i === 0 ? 'true' : undefined}
					/>
				))}
			</div>
		</div>
		<div class="values__panel print:hidden" aria-hidden="true">
			{companyValues.map((value, i) => (
				<Image
					src={value.image}
					alt=""
					widths={[640, 960, 1280, 1920]}
					sizes="(min-width: 1024px) 700px, 100vw"
					loading="lazy"
					class:list={['values__photo', i === 0 && 'is-active']}
				/>
			))}
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;

	// The section is page-wide, so `--band-gutter` (which resolves its 100% against the box it pads)
	// puts the card on the page measure.
	.values {
		padding: $spacing-12 var(--band-gutter) $spacing-20;
		background: var(--color-bg-surface);
	}

	// As the page's other section titles.
	.values__heading {
		@include section-title;
		font-weight: $font-weight-bold;
		color: var(--color-text);
		text-align: center;
		margin: 0 0 $spacing-12;
	}

	// The homepage hero's ground and ink. Stacked below lg (words, then photo); from lg the words take
	// a third and the photo two.
	.values__card {
		display: grid;
		grid-template-columns: 1fr;
		overflow: hidden;
		isolation: isolate;
		border-radius: $radius-xl;
		background-color: #000;
		color: #fff;

		@include media-up(lg) {
			grid-template-columns: 1fr 2fr;
			min-height: 440px;
		}
	}

	.values__copy {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: $spacing-8;
		padding: $spacing-8 $spacing-6;

		@include media-up(md) {
			padding: $spacing-10;
		}
	}

	// Every value's words share one cell, so the column is as tall as the longest and nothing jumps.
	.values__texts {
		display: grid;
	}

	.values__text {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: $spacing-3;
		opacity: 0;
		visibility: hidden;
		transform: translate3d(0, 12px, 0);
		transition:
			opacity 0.5s ease,
			transform 0.5s ease,
			visibility 0s 0.5s;

		&.is-active {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition:
				opacity 0.5s ease 0.15s,
				transform 0.5s ease 0.15s;
		}

		@media (prefers-reduced-motion: reduce) {
			transform: none;
			transition: none;

			&.is-active {
				transition: none;
			}
		}

		// Mark renders the element, so this component's scope does not reach it.
		:global(.values__mark) {
			margin-bottom: $spacing-3;
		}
	}

	.values__title {
		@include type-section;
		margin: 0;
		text-wrap: balance;
	}

	.values__lede {
		@include type-body;
		color: rgb(255 255 255 / 72%);
		max-width: 40ch;
		margin: 0;
		text-wrap: pretty;
	}

	.values__dots {
		display: flex;
		gap: $spacing-2;
	}

	.values__dot {
		position: relative;
		width: 10px;
		height: 10px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: var(--color-white);
		opacity: 0.45;
		cursor: pointer;
		transition:
			opacity 0.3s ease,
			background-color 0.3s ease;
		@include focus-ring(3px);
		@include touch-target(10px);

		&:hover {
			opacity: 1;
		}

		&.is-active {
			background: var(--accent-fill);
			opacity: 1;
		}
	}

	.values__dot:focus-visible {
		outline-color: #fff;
	}

	// The photo, cropped to its cell and faded in from the card's black: from the top when stacked,
	// from the left beside the words. A paint over the photo, as the hero's, not a mask.
	.values__panel {
		position: relative;
		aspect-ratio: 16 / 9;
		cursor: grab;
		touch-action: pan-y;

		&.is-dragging {
			cursor: grabbing;
		}

		@include media-up(lg) {
			aspect-ratio: auto;
		}

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			pointer-events: none;
			background-image: linear-gradient(
				to bottom,
				#000 0,
				rgb(0 0 0 / 70%) 16px,
				rgb(0 0 0 / 30%) 40px,
				rgb(0 0 0 / 0%) 64px
			);

			@include media-up(lg) {
				background-image: linear-gradient(
					to right,
					#000 0,
					rgb(0 0 0 / 75%) 24px,
					rgb(0 0 0 / 40%) 56px,
					rgb(0 0 0 / 12%) 88px,
					rgb(0 0 0 / 0%) 120px
				);
			}
		}
	}

	.values__photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.8s ease;
		user-select: none;
		-webkit-user-drag: none;

		&.is-active {
			opacity: 1;
		}

		@media (prefers-reduced-motion: reduce) {
			transition: none;
		}
	}

	@media print {
		.values {
			padding: $spacing-6 0;
		}

		.values__card {
			display: block;
			background: none;
			color: var(--color-text);
		}

		.values__copy {
			padding: 0;
		}

		.values__texts {
			display: block;
		}

		.values__text {
			opacity: 1;
			visibility: visible;
			transform: none;
			margin-bottom: $spacing-4;
			break-inside: avoid;

			:global(.values__mark) {
				display: none;
			}
		}

		.values__title {
			font-size: $font-size-2xl;
		}

		.values__lede {
			color: var(--color-text);
		}
	}
</style>

<script>
	const section = document.querySelector<HTMLElement>('[data-values-split]');

	if (section) {
		const texts = section.querySelectorAll<HTMLElement>('.values__text');
		const photos = section.querySelectorAll<HTMLElement>('.values__photo');
		const dots = section.querySelectorAll<HTMLButtonElement>('.values__dot');
		const panel = section.querySelector<HTMLElement>('.values__panel')!;
		const total = texts.length;
		const AUTOPLAY_INTERVAL = 6000;
		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		const goTo = (index: number) => {
			const next = (index + total) % total;
			if (next === current) return;
			for (const list of [texts, photos, dots]) {
				list[current].classList.remove('is-active');
				list[next].classList.add('is-active');
			}
			texts[current].setAttribute('aria-hidden', 'true');
			texts[next].removeAttribute('aria-hidden');
			dots[current].removeAttribute('aria-current');
			dots[next].setAttribute('aria-current', 'true');
			current = next;
		};

		// Autoplay only where motion is welcome, and only while the band is on screen and not in use.
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let visible = false;
		let held = false;
		const stop = () => {
			clearInterval(timer);
			timer = undefined;
		};
		const sync = () => {
			stop();
			if (!reduce && visible && !held) timer = setInterval(() => goTo(current + 1), AUTOPLAY_INTERVAL);
		};

		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			sync();
		}).observe(section);

		section.addEventListener('pointerenter', () => ((held = true), sync()));
		section.addEventListener('pointerleave', () => ((held = false), sync()));
		section.addEventListener('focusin', () => ((held = true), sync()));
		section.addEventListener('focusout', () => ((held = false), sync()));

		dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

		// A swipe on the photo steps one value.
		let startX: number | null = null;
		panel.addEventListener('pointerdown', (e) => {
			startX = e.clientX;
			panel.classList.add('is-dragging');
		});
		window.addEventListener('pointerup', (e) => {
			if (startX === null) return;
			const diff = startX - e.clientX;
			startX = null;
			panel.classList.remove('is-dragging');
			if (Math.abs(diff) > 50) goTo(diff > 0 ? current + 1 : current - 1);
		});
		window.addEventListener('pointercancel', () => {
			startX = null;
			panel.classList.remove('is-dragging');
		});
	}
</script>
