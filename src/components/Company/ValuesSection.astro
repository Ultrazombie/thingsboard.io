---
/**
 * "Our values": the section's title, then a black card on the page measure — the value's words in a
 * third (its mark, title and sentence, the dots underneath) and its photo in the other two, faded in
 * from the black as the homepage hero's footage is. Contained because the photos are not sharp enough
 * to run full width. A carousel: the photos sit on a track that follows a drag (mouse or touch) and
 * settles on the nearest value; the words follow the drag and cross-fade in its direction. No scrim,
 * blur or scaling. The earlier full-bleed version is `ValuesSectionOverlay`.
 */
import { Image } from 'astro:assets';
import Mark from '../ui/Mark.astro';
import { companyValues } from '~/data/company/values';
import '@styles/ui-kit.scss';
---

<section class="values" data-values-split aria-roledescription="carousel" aria-labelledby="values-title">
	<h2 class="values__heading" id="values-title">Our values</h2>
	<div class="values__card" data-reveal>
		<div class="values__copy">
			<div class="values__texts">
				{companyValues.map((value, i) => (
					<div class:list={['values__text', i === 0 && 'is-active']} aria-hidden={i === 0 ? undefined : 'true'}>
						<Mark size={48} icon={value.mark.icon} accent={value.mark.accent} class="values__mark" />
						<h3 class="values__title">{value.title}</h3>
						<p class="values__lede">{value.description}</p>
					</div>
				))}
			</div>
			<div class="values__dots print:hidden">
				{companyValues.map((value, i) => (
					<button
						type="button"
						class:list={['values__dot', i === 0 && 'is-active']}
						aria-label={value.title}
						aria-current={i === 0 ? 'true' : undefined}
					/>
				))}
			</div>
		</div>
		<div class="values__panel print:hidden" aria-hidden="true">
			<div class="values__track">
				{companyValues.map((value) => (
					<Image
						src={value.image}
						alt=""
						widths={[640, 960, 1280, 1920]}
						sizes="(min-width: 1024px) 700px, 100vw"
						loading="lazy"
						draggable="false"
						class="values__photo"
					/>
				))}
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;

	// The section is page-wide, so `--band-gutter` (which resolves its 100% against the box it pads)
	// puts the card on the page measure.
	.values {
		padding: $spacing-12 var(--band-gutter);
		background: var(--color-bg-surface);

		@include media-down(md) {
			padding-block: $spacing-8;
		}
	}

	// As the page's other section titles.
	.values__heading {
		@include section-title;
		font-weight: $font-weight-bold;
		color: var(--color-text);
		text-align: center;
		margin: 0 0 $spacing-10;

		@include media-down(md) {
			margin-bottom: $spacing-8;
		}
	}

	// The homepage hero's ground and ink. Stacked below lg (words, then photo); from lg the words take
	// a third and the photo two.
	.values__card {
		display: grid;
		grid-template-columns: 1fr;
		overflow: hidden;
		isolation: isolate;
		border-radius: $radius-xl;
		background-color: #000;
		color: #fff;
		touch-action: pan-y;

		// While a drag is on: no text selection, and the hand closes.
		&.is-dragging {
			user-select: none;
			cursor: grabbing;
		}

		@include media-up(lg) {
			grid-template-columns: 1fr 2fr;
			min-height: 440px;
		}
	}

	.values__copy {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: $spacing-8;
		padding: $spacing-8 $spacing-6;

		@include media-up(md) {
			padding: $spacing-10;
		}
	}

	// The carousel's settle, for the track and the words alike: quick out, long soft landing.
	$settle: 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);

	// Every value's words share one cell, so the column is as tall as the longest and nothing jumps.
	// `--dir` (1 forward, -1 back, set by the script) is the side the next words arrive from.
	.values__texts {
		--dir: 1;

		display: grid;
	}

	.values__text {
		grid-area: 1 / 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: $spacing-3;
		opacity: 0;
		visibility: hidden;
		transform: translate3d(calc(var(--dir) * 24px), 0, 0);
		transition:
			opacity 0.3s ease,
			transform $settle,
			visibility 0s 0.3s;

		&.is-active {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition:
				opacity 0.45s ease 0.12s,
				transform $settle 0.12s;
		}

		// The words leaving go the other way.
		&.is-leaving {
			transform: translate3d(calc(var(--dir) * -24px), 0, 0);
		}

		@media (prefers-reduced-motion: reduce) {
			transform: none;
			transition: none;

			&.is-active {
				transition: none;
			}
		}

		// Mark renders the element, so this component's scope does not reach it.
		:global(.values__mark) {
			margin-bottom: $spacing-3;
		}
	}

	.values__title {
		@include type-section;
		margin: 0;
		text-wrap: balance;
	}

	.values__lede {
		@include type-body;
		color: rgb(255 255 255 / 72%);
		max-width: 40ch;
		margin: 0;
		text-wrap: pretty;
	}

	.values__dots {
		display: flex;
		gap: $spacing-2;
	}

	.values__dot {
		position: relative;
		width: 10px;
		height: 10px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: var(--color-white);
		opacity: 0.45;
		cursor: pointer;
		transition:
			opacity 0.3s ease,
			background-color 0.3s ease;
		@include focus-ring(3px);
		@include touch-target(10px);

		&:hover {
			opacity: 1;
		}

		&.is-active {
			background: var(--accent-fill);
			opacity: 1;
		}
	}

	.values__dot:focus-visible {
		outline-color: #fff;
	}

	// The photo, cropped to its cell and faded in from the card's black: from the top when stacked,
	// from the left beside the words. A paint over the photo, as the hero's, not a mask.
	.values__panel {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 9;
		cursor: grab;

		@include media-up(lg) {
			aspect-ratio: auto;
		}

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			pointer-events: none;
			background-image: linear-gradient(
				to bottom,
				#000 0,
				rgb(0 0 0 / 70%) 16px,
				rgb(0 0 0 / 30%) 40px,
				rgb(0 0 0 / 0%) 64px
			);

			@include media-up(lg) {
				background-image: linear-gradient(
					to right,
					#000 0,
					rgb(0 0 0 / 75%) 24px,
					rgb(0 0 0 / 40%) 56px,
					rgb(0 0 0 / 12%) 88px,
					rgb(0 0 0 / 0%) 120px
				);
			}
		}
	}

	// One photo per value, side by side; the script moves the strip a photo's width per value.
	.values__track {
		position: absolute;
		inset: 0;
		display: flex;
		transition: transform $settle;
		will-change: transform;

		@media (prefers-reduced-motion: reduce) {
			transition: none;
		}
	}

	.values__photo {
		flex: 0 0 100%;
		width: 100%;
		height: 100%;
		object-fit: cover;
		user-select: none;
		-webkit-user-drag: none;
	}

	@media print {
		.values {
			padding: $spacing-6 0;
		}

		.values__card {
			display: block;
			background: none;
			color: var(--color-text);
		}

		.values__copy {
			padding: 0;
		}

		.values__texts {
			display: block;
		}

		.values__text {
			opacity: 1;
			visibility: visible;
			transform: none;
			margin-bottom: $spacing-4;
			break-inside: avoid;

			:global(.values__mark) {
				display: none;
			}
		}

		.values__title {
			font-size: $font-size-2xl;
		}

		.values__lede {
			color: var(--color-text);
		}
	}
</style>

<script>
	const section = document.querySelector<HTMLElement>('[data-values-split]');

	if (section) {
		const card = section.querySelector<HTMLElement>('.values__card')!;
		const panel = section.querySelector<HTMLElement>('.values__panel')!;
		const track = section.querySelector<HTMLElement>('.values__track')!;
		const textBox = section.querySelector<HTMLElement>('.values__texts')!;
		const texts = section.querySelectorAll<HTMLElement>('.values__text');
		const dots = section.querySelectorAll<HTMLButtonElement>('.values__dot');
		const total = texts.length;
		const last = total - 1;
		const AUTOPLAY_INTERVAL = 6000;
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let current = 0;

		// The track sits a photo's width per value to the left, plus however far a drag has pulled it.
		const place = (pull = 0) => {
			track.style.transform = `translate3d(calc(${-current * 100}% + ${pull}px), 0, 0)`;
		};

		const goTo = (index: number) => {
			const next = (index + total) % total;
			if (next === current) return place();
			// Only autoplay asks for an index past either end; it loops round with a short fade rather
			// than a sweep back across every photo, and keeps moving forward. A jump between the first
			// and last value (a dot, a key) slides like any other.
			const wraps = index < 0 || index > last;
			const forward = wraps ? index > last : next > current;

			textBox.style.setProperty('--dir', forward ? '1' : '-1');
			texts.forEach((t) => t.classList.remove('is-leaving'));
			texts[current].classList.add('is-leaving');
			texts[current].classList.remove('is-active');
			texts[current].setAttribute('aria-hidden', 'true');
			texts[next].classList.add('is-active');
			texts[next].removeAttribute('aria-hidden');
			dots[current].classList.remove('is-active');
			dots[current].removeAttribute('aria-current');
			dots[next].classList.add('is-active');
			dots[next].setAttribute('aria-current', 'true');
			current = next;

			if (wraps && !reduce) {
				panel.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 200, easing: 'ease-in' }).finished.then(() => {
					track.style.transition = 'none';
					place();
					void track.offsetWidth;
					track.style.transition = '';
					panel.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 350, easing: 'ease-out' });
				});
			} else {
				place();
			}
		};

		// Autoplay only where motion is welcome, while the band is on screen and not in use.
		let timer: ReturnType<typeof setInterval> | undefined;
		let visible = false;
		let held = false;
		const sync = () => {
			clearInterval(timer);
			timer = undefined;
			if (!reduce && visible && !held) timer = setInterval(() => goTo(current + 1), AUTOPLAY_INTERVAL);
		};
		const hold = (on: boolean) => {
			held = on;
			sync();
		};

		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			sync();
		}).observe(section);

		section.addEventListener('pointerenter', () => hold(true));
		section.addEventListener('pointerleave', () => hold(false));
		section.addEventListener('focusin', () => hold(true));
		section.addEventListener('focusout', () => hold(false));

		dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

		section.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') goTo(Math.min(last, current + 1));
			else if (e.key === 'ArrowLeft') goTo(Math.max(0, current - 1));
		});

		// Drag anywhere on the card but the dots. It takes over once the pointer has moved 6px more
		// sideways than down, so a vertical swipe still scrolls the page. Past the first and last value
		// the track gives at a third of the pull. On release it steps if the pull passed a sixth of the
		// photo or was a flick, and settles back otherwise.
		let start: { x: number; y: number; t: number; id: number } | null = null;
		let dragging = false;
		let pull = 0;

		const endDrag = (step: number) => {
			card.classList.remove('is-dragging');
			track.style.transition = '';
			texts[current].style.removeProperty('opacity');
			texts[current].style.removeProperty('transform');
			dragging = false;
			start = null;
			goTo(Math.max(0, Math.min(last, current + step)));
		};

		card.addEventListener('pointerdown', (e) => {
			if (e.button !== 0 || (e.target as Element).closest('.values__dots')) return;
			start = { x: e.clientX, y: e.clientY, t: performance.now(), id: e.pointerId };
		});

		card.addEventListener('pointermove', (e) => {
			if (!start || e.pointerId !== start.id) return;
			// The press ended where the card could not hear it (released outside before the drag began).
			if (!(e.buttons & 1)) {
				start = null;
				return;
			}
			const dx = e.clientX - start.x;
			if (!dragging) {
				if (Math.abs(dx) < 6 || Math.abs(dx) < Math.abs(e.clientY - start.y)) return;
				dragging = true;
				// Keeps the drag when the pointer leaves the card; a pointer the browser no longer tracks
				// cannot be captured, and the drag still works without it.
				try {
					card.setPointerCapture(e.pointerId);
				} catch {}
				card.classList.add('is-dragging');
				track.style.transition = 'none';
				hold(true);
			}
			const atEnd = (current === 0 && dx > 0) || (current === last && dx < 0);
			pull = atEnd ? dx / 3 : dx;
			place(pull);
			const share = Math.min(1, Math.abs(pull) / (panel.clientWidth * 0.6));
			texts[current].style.transition = 'none';
			texts[current].style.opacity = String(1 - share);
			texts[current].style.transform = `translate3d(${pull * 0.08}px, 0, 0)`;
		});

		const release = (e: PointerEvent) => {
			if (!start || e.pointerId !== start.id) return;
			if (!dragging) return void (start = null);
			const speed = pull / (performance.now() - start.t);
			const far = Math.abs(pull) > panel.clientWidth / 6 || Math.abs(speed) > 0.5;
			texts[current].style.removeProperty('transition');
			endDrag(far ? (pull < 0 ? 1 : -1) : 0);
			hold(card.matches(':hover'));
		};
		card.addEventListener('pointerup', release);
		card.addEventListener('pointercancel', release);

		place();
	}
</script>
