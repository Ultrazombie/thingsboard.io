---
/**
 * "Our values", composed as the homepage hero: a black band, the words on the left (the section's
 * name as the faded kicker, the value as the headline, its sentence as the lede, the dots where the
 * hero has its buttons) and the photo on the right, faded in from the black. Slides cross-fade; no
 * scrim, blur or pattern. The earlier full-bleed version is `ValuesSectionOverlay`.
 */
import { Image } from 'astro:assets';
import { companyValues } from '~/data/company/values';
import '@styles/ui-kit.scss';
---

<section class="values" data-values-split aria-roledescription="carousel" aria-labelledby="values-title">
	<div class="values__copy">
		<h2 class="values__kicker" id="values-title">Our values</h2>
		<div class="values__texts">
			{companyValues.map((value, i) => (
				<div class:list={['values__text', i === 0 && 'is-active']} aria-hidden={i === 0 ? undefined : 'true'}>
					<h3 class="values__title">{value.title}</h3>
					<p class="values__lede">{value.description}</p>
				</div>
			))}
		</div>
		<div class="values__dots print:hidden">
			{companyValues.map((value, i) => (
				<button
					type="button"
					class:list={['values__dot', i === 0 && 'is-active']}
					aria-label={value.title}
					aria-current={i === 0 ? 'true' : undefined}
				/>
			))}
		</div>
	</div>
	<div class="values__panel print:hidden" aria-hidden="true">
		{companyValues.map((value, i) => (
			<Image
				src={value.image}
				alt=""
				widths={[640, 960, 1280, 1920]}
				sizes="(min-width: 1024px) 60vw, 100vw"
				loading="lazy"
				class:list={['values__photo', i === 0 && 'is-active']}
			/>
		))}
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;
	@use '../../styles/ui' as *;

	// The copy column's width, on the side-by-side layout.
	$copy-w: 440px;

	// Same ground and ink as the homepage hero, which is always black. `--band-gutter` resolves its
	// 100% against the box it pads, so only boxes as wide as the page take it: the copy when the two
	// stack, the band's own left edge when they sit side by side (the photo runs to the right edge).
	.values {
		display: grid;
		grid-template-columns: 1fr;
		background-color: #000;
		color: #fff;

		@include media-up(lg) {
			grid-template-columns: $copy-w minmax(0, 1fr);
			min-height: 560px;
			padding-left: var(--band-gutter);
		}
	}

	.values__copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: $spacing-16 var(--band-gutter) $spacing-10;

		@include media-up(lg) {
			padding: $spacing-20 $spacing-10 $spacing-20 0;
		}
	}

	// The kicker and the value's title read as the hero's two-line headline.
	.values__kicker,
	.values__title {
		@include hero-title;
		margin: 0;
		text-wrap: balance;
	}

	// The hero's kicker: the same fade as its first title line.
	.values__kicker {
		background-image: linear-gradient(to bottom, rgb(255 255 255 / 62%), rgb(255 255 255 / 38%));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	// Every value's words share one cell, so the column is as tall as the longest and nothing jumps.
	.values__texts {
		display: grid;
	}

	.values__text {
		grid-area: 1 / 1;
		opacity: 0;
		visibility: hidden;
		transform: translate3d(0, 16px, 0);
		transition:
			opacity 0.5s ease,
			transform 0.5s ease,
			visibility 0s 0.5s;

		&.is-active {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition:
				opacity 0.5s ease 0.15s,
				transform 0.5s ease 0.15s;
		}

		@media (prefers-reduced-motion: reduce) {
			transform: none;
			transition: none;

			&.is-active {
				transition: none;
			}
		}
	}

	.values__title {
		margin-bottom: $spacing-5;
	}

	.values__lede {
		@include text-m;
		font-size: $font-size-lg;
		color: #fff;
		max-width: 44ch;
		margin: 0;
		text-wrap: pretty;
	}

	.values__dots {
		display: flex;
		gap: $spacing-2;
		margin-top: $spacing-8;
	}

	.values__dot {
		position: relative;
		width: 12px;
		height: 12px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: var(--color-white);
		opacity: 0.5;
		cursor: pointer;
		transition:
			opacity 0.3s ease,
			background-color 0.3s ease;
		@include focus-ring(3px);
		@include touch-target(12px);

		&:hover {
			opacity: 1;
		}

		&.is-active {
			background: var(--accent-fill);
			opacity: 1;
		}
	}

	.values__dot:focus-visible {
		outline-color: #fff;
	}

	// The photo: cropped to the panel, faded in from the band's black. A paint over the photo, as the
	// hero's, not a mask.
	.values__panel {
		position: relative;
		aspect-ratio: 3 / 2;
		overflow: hidden;
		cursor: grab;
		touch-action: pan-y;

		&.is-dragging {
			cursor: grabbing;
		}

		@include media-up(md) {
			aspect-ratio: 16 / 9;
		}

		@include media-up(lg) {
			aspect-ratio: auto;
		}

		&::after {
			content: '';
			position: absolute;
			inset: 0;
			pointer-events: none;
			background-image: linear-gradient(
				to bottom,
				#000 0,
				rgb(0 0 0 / 82%) 24px,
				rgb(0 0 0 / 50%) 48px,
				rgb(0 0 0 / 18%) 72px,
				rgb(0 0 0 / 0%) 96px
			);

			@include media-up(lg) {
				background-image: linear-gradient(
					to right,
					#000 0,
					rgb(0 0 0 / 90%) 40px,
					rgb(0 0 0 / 68%) 90px,
					rgb(0 0 0 / 38%) 140px,
					rgb(0 0 0 / 12%) 190px,
					rgb(0 0 0 / 0%) 240px
				);
			}
		}
	}

	.values__photo {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.8s ease;
		user-select: none;
		-webkit-user-drag: none;

		&.is-active {
			opacity: 1;
		}

		@media (prefers-reduced-motion: reduce) {
			transition: none;
		}
	}

	@media print {
		.values {
			display: block;
			background: none;
			color: var(--color-text);
		}

		.values__copy {
			padding: $spacing-6 0;
		}

		.values__kicker {
			background-image: none;
			color: var(--color-text);
			margin-bottom: $spacing-4;
		}

		.values__texts {
			display: block;
		}

		.values__text {
			opacity: 1;
			visibility: visible;
			transform: none;
			margin-bottom: $spacing-4;
			break-inside: avoid;
		}

		.values__title {
			font-size: $font-size-3xl;
			margin-bottom: $spacing-2;
		}

		.values__lede {
			color: var(--color-text);
		}
	}
</style>

<script>
	const section = document.querySelector<HTMLElement>('[data-values-split]');

	if (section) {
		const texts = section.querySelectorAll<HTMLElement>('.values__text');
		const photos = section.querySelectorAll<HTMLElement>('.values__photo');
		const dots = section.querySelectorAll<HTMLButtonElement>('.values__dot');
		const panel = section.querySelector<HTMLElement>('.values__panel')!;
		const total = texts.length;
		const AUTOPLAY_INTERVAL = 6000;
		let current = 0;
		let timer: ReturnType<typeof setInterval> | undefined;

		const goTo = (index: number) => {
			const next = (index + total) % total;
			if (next === current) return;
			for (const list of [texts, photos, dots]) {
				list[current].classList.remove('is-active');
				list[next].classList.add('is-active');
			}
			texts[current].setAttribute('aria-hidden', 'true');
			texts[next].removeAttribute('aria-hidden');
			dots[current].removeAttribute('aria-current');
			dots[next].setAttribute('aria-current', 'true');
			current = next;
		};

		// Autoplay only where motion is welcome, and only while the band is on screen and not in use.
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let visible = false;
		let held = false;
		const stop = () => {
			clearInterval(timer);
			timer = undefined;
		};
		const sync = () => {
			stop();
			if (!reduce && visible && !held) timer = setInterval(() => goTo(current + 1), AUTOPLAY_INTERVAL);
		};

		new IntersectionObserver(([entry]) => {
			visible = entry.isIntersecting;
			sync();
		}).observe(section);

		section.addEventListener('pointerenter', () => ((held = true), sync()));
		section.addEventListener('pointerleave', () => ((held = false), sync()));
		section.addEventListener('focusin', () => ((held = true), sync()));
		section.addEventListener('focusout', () => ((held = false), sync()));

		dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

		// A swipe on the photo steps one value.
		let startX: number | null = null;
		panel.addEventListener('pointerdown', (e) => {
			startX = e.clientX;
			panel.classList.add('is-dragging');
		});
		window.addEventListener('pointerup', (e) => {
			if (startX === null) return;
			const diff = startX - e.clientX;
			startX = null;
			panel.classList.remove('is-dragging');
			if (Math.abs(diff) > 50) goTo(diff > 0 ? current + 1 : current - 1);
		});
		window.addEventListener('pointercancel', () => {
			startX = null;
			panel.classList.remove('is-dragging');
		});
	}
</script>
