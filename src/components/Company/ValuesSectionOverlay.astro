---
/**
 * The earlier "Our values" carousel: each value full width over its photo, under a dark scrim and the
 * pattern, the slides beside the active one blurred. Not on the page; `ValuesSection` (split) is. Kept
 * to compare against: swap the import in `src/pages/company/index.astro` to bring it back.
 */
import { getImage } from 'astro:assets';
import Mark from '../ui/Mark.astro';
import { companyValues } from '~/data/company/values';

const values = await Promise.all(
	companyValues.map(async (value) => ({ ...value, src: (await getImage({ src: value.image })).src })),
);
---

<section class="values-section">
	<h2 class="values-title">Our values</h2>
	<div class="values-wrapper">
		<div class="values-viewport">
			<div class="values-track">
				{values.map((item, i) => (
					<div class={`values-slide${i === 0 ? ' active' : ''}`} style={`background-image: url(${item.src})`}>
						<div class="values-text">
							<Mark size={64} icon={item.mark.icon} accent={item.mark.accent} lift class="values-mark" />
							<h3 class="values-card-title">{item.title}</h3>
							<p class="values-card-desc">{item.description}</p>
						</div>
					</div>
				))}
			</div>
			<div class="values-dots print:hidden">
				{values.map((_, i) => (
					<button class={`values-dot${i === 0 ? ' active' : ''}`} aria-label={`Slide ${i + 1}`}></button>
				))}
			</div>
		</div>
	</div>
</section>

<style lang="scss">
	@use '../../styles/variables' as *;

	.values-section {
		overflow: hidden;
		background: var(--color-bg-surface);
		padding-bottom: $spacing-20;
		opacity: 0;
	}

	.values-section.animate {
		animation: reveal-ltr 0.8s ease-in-out forwards, opacity-reveal 1.5s ease-out forwards;
	}

	@keyframes reveal-ltr {
		from { clip-path: inset(0 100% 0 0); }
		to   { clip-path: inset(0 0 0 0); }
	}

	@keyframes opacity-reveal {
		from { opacity: 0; }
		to   { opacity: 1; }
	}

	.values-title {
		@include section-title;
		font-weight: $font-weight-bold;
		color: var(--color-text);
		text-align: center;
		padding: $spacing-12 var(--band-gutter);
		margin: 0;
	}

	.values-wrapper {
		max-width: 1920px;
		margin: 0 auto;
		position: relative;
	}

	.values-viewport {
		overflow: visible;
		position: relative;
		cursor: grab;

		&.dragging {
			cursor: grabbing;
		}
	}

	.values-track {
		display: flex;
		transition: transform 0.5s ease;
	}

	.values-slide {
		flex: 0 0 100%;
		height: 756px;
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		position: relative;
		display: flex;
		align-items: center;
		filter: blur(8px);
		transform: scale(0.9);
		transition: filter 0.5s ease, transform 0.5s ease;

		&.active {
			filter: blur(0);
			transform: scale(1);
		}

		// Dark color overlay + backdrop blur
		&::after {
			content: '';
			position: absolute;
			inset: 0;
			background-color: #3f474f99;
			backdrop-filter: blur(4px);
			z-index: 1;
		}

		// ThingsBoard pattern overlay
		&::before {
			content: '';
			position: absolute;
			inset: 0;
			background-image: url('/tbstyled-bg.svg');
			background-repeat: no-repeat;
			opacity: 0.3;
			z-index: 2;
		}
	}

	// The photo runs full width; the words sit on the page measure.
	.values-text {
		position: relative;
		z-index: 3;
		padding: $spacing-8 var(--band-gutter);
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: $spacing-4;
	}

	.values-card-title {
		font-size: 96px;
		font-weight: $font-weight-medium;
		line-height: 125%;
		color: var(--color-white);
		margin: 0;
	}

	.values-card-desc {
		font-size: $font-size-5xl;
		font-weight: $font-weight-normal;
		line-height: 140%;
		color: var(--color-white);
		max-width: 935px;
		margin: 0;
	}

	.values-dots {
		position: absolute;
		bottom: 5px;
		left: 50%;
		transform: translate(-50%, -50%);
		display: flex;
		align-items: center;
		z-index: 4;
	}

	.values-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: none;
		background: var(--color-white);
		cursor: pointer;
		padding: 0;
		margin: 5px 7px;
		transition: background 0.3s ease;

		&.active,
		&:hover {
			background: var(--accent-fill);
		}
	}

	@include media-down(xl) {
		.values-card-title { font-size: 64px; }
	}

	@include media-down(lg) {
		.values-card-title { font-size: 56px; }
		.values-card-desc { font-size: $font-size-4xl; }
	}

	@include media-down(md) {
		.values-card-title { font-size: 40px; }
		.values-text :global(.values-mark) { --mark-size: 48px; --mark-icon: 28px; }
		.values-title { padding-block: $spacing-14 $spacing-8; }
	}

	@media print {
		.values-section {
			opacity: 1;
			overflow: visible;
		}

		.values-track {
			display: block;
			transform: none !important;
		}

		.values-slide {
			height: auto;
			margin-bottom: 24px;
			filter: none;
			transform: none;
			background-image: none !important;
			break-inside: avoid;

			&::before,
			&::after {
				content: none;
			}
		}

		.values-text :global(.values-mark) {
			display: none;
		}

		.values-text {
			padding: 0;
			gap: 8px;
		}

		.values-card-title {
			font-size: $font-size-3xl;
			color: var(--color-text);
		}

		.values-card-desc {
			font-size: $font-size-lg;
			color: var(--color-text);
		}
	}
</style>

<script>
	const section = document.querySelector('.values-section') as HTMLElement;
	const track = document.querySelector('.values-track') as HTMLElement;
	const viewport = document.querySelector('.values-viewport') as HTMLElement;
	const slides = document.querySelectorAll('.values-slide');
	const dots = document.querySelectorAll('.values-dot');
	const total = slides.length;
	let current = 0;

	function goTo(index: number): void {
		slides[current].classList.remove('active');
		dots[current].classList.remove('active');
		current = (index + total) % total;
		slides[current].classList.add('active');
		dots[current].classList.add('active');
		track.style.transform = `translateX(-${current * 100}%)`;
	}

	dots.forEach((dot, i) => dot.addEventListener('click', () => { goTo(i); resetAutoplay(); }));

	// Autoplay
	const AUTOPLAY_INTERVAL = 5000;
	let autoplayTimer: ReturnType<typeof setInterval>;

	function startAutoplay(): void {
		autoplayTimer = setInterval(() => goTo(current + 1), AUTOPLAY_INTERVAL);
	}

	function stopAutoplay(): void {
		clearInterval(autoplayTimer);
	}

	function resetAutoplay(): void {
		stopAutoplay();
		startAutoplay();
	}

	startAutoplay();

	// Drag
	let dragging = false;
	let dragStartX = 0;
	let didDrag = false;

	function startDrag(clientX: number): void {
		dragging = true;
		didDrag = false;
		dragStartX = clientX;
		track.style.transition = 'none';
		viewport.classList.add('dragging');
		stopAutoplay();
	}

	function endDrag(clientX: number): void {
		if (!dragging) return;
		dragging = false;
		viewport.classList.remove('dragging');
		track.style.transition = '';
		const diff = dragStartX - clientX;
		if (Math.abs(diff) > 50) {
			didDrag = true;
			goTo(diff > 0 ? current + 1 : current - 1);
		} else {
			track.style.transform = `translateX(-${current * 100}%)`;
		}
		startAutoplay();
	}

	viewport.addEventListener('mousedown', (e) => { startDrag(e.clientX); e.preventDefault(); });
	window.addEventListener('mouseup', (e) => { endDrag(e.clientX); });
	viewport.addEventListener('touchstart', (e) => { startDrag(e.touches[0].clientX); }, { passive: true });
	window.addEventListener('touchend', (e) => { endDrag(e.changedTouches[0].clientX); });

	viewport.addEventListener('click', (e) => {
		if (didDrag) { e.stopPropagation(); didDrag = false; }
	}, true);

	// Scroll reveal
	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					section.classList.add('animate');
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.3 }
	);
	observer.observe(section);
</script>
