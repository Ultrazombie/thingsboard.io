---
import Mark from '../ui/Mark.astro';
---

<address class="contacts-wrapper">
	<ul class="contacts-list">
		<li>
			<Mark size={40} icon="tabler:phone" fill="wash" />
			<a href="tel:+12123344096">+1 212 334 4096</a>
		</li>
		<li>
			<Mark size={40} icon="tabler:map-pin" fill="wash" />
			<span>110 Duane Street, Suite 1C, New York, NY 10007, USA</span>
		</li>
		<li>
			<Mark size={40} icon="tabler:mail" fill="wash" />
			<a href="mailto:info@thingsboard.io">info@thingsboard.io</a>
		</li>
	</ul>
</address>

<style lang="scss">
	@use '../../styles/variables' as *;

	.contacts-wrapper {
		padding: $spacing-30 var(--band-gutter);
		font-style: normal;
	}

	.contacts-list {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: $spacing-5;
		flex-wrap: wrap;
		list-style: none;
		padding: 0;
		margin: 0;

		li {
			display: flex;
			align-items: center;
			gap: $spacing-3;
			font-size: $font-size-lg;
			color: var(--color-text-secondary);
		}

		a {
			color: var(--color-text);
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}
		}
	}

	@include media-down(lg) {
		.contacts-wrapper {
			padding-block: $spacing-16;
		}

		.contacts-list {
			gap: $spacing-8;
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media print {
		.contacts-wrapper {
			padding-top: 24px;
			break-inside: avoid;
		}

		.contacts-list {
			padding: 0;
			gap: 12px;
		}
	}
</style>
