				<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 5.55 5.55l.91-.91a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7a2 2 0 0 1 1.72 2.02z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
			<a href="tel:+12123344096">+1 212 334 4096</a>
		</li>
		<li>
			<svg class="contacts-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				<circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
			<span>110 Duane Street, Suite 1C, New York, NY 10007, USA</span>
		</li>
		<li>
			<svg class="contacts-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
				<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				<polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
			<a href="mailto:info@thingsboard.io">info@thingsboard.io</a>
		</li>
	</ul>
</address>

<style lang="scss">
	@use '../../styles/variables' as *;

	.contacts-wrapper {
		padding: $spacing-30 var(--band-gutter);
		font-style: normal;
	}

	.contacts-list {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: $spacing-5;
		flex-wrap: wrap;
		list-style: none;
		padding: 0;
		margin: 0;

		li {
			display: flex;
			align-items: center;
			gap: $spacing-3;
			font-size: $font-size-lg;
			color: var(--color-text-secondary);
		}

		a {
			color: var(--color-text);
			text-decoration: none;

			&:hover {
				text-decoration: underline;
			}
		}
	}

	.contacts-icon {
		width: 22px;
		height: 22px;
		flex-shrink: 0;
		color: var(--color-text);
	}

	@include media-down(lg) {
		.contacts-wrapper {
			padding-block: $spacing-16;
		}

		.contacts-list {
			gap: $spacing-8;
			flex-direction: column;
			align-items: flex-start;
		}
	}

	@media print {
		.contacts-wrapper {
			padding-top: 24px;
			break-inside: avoid;
		}

		.contacts-list {
			padding: 0;
			gap: 12px;
		}
	}
</style>
